# .editorconfig

# This is the top-level EditorConfig
root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown intentionally uses trailing spaces
[*.md]
trim_trailing_whitespace = false

# Windows scripts require CRLF
[*.{bat,cmd}]
end_of_line = crlf