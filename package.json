    "@supabase/supabase-js": "^2.81.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "browser-image-compression": "^2.0.2",
    "jose": "^6.1.2",
    "lucide-react": "^0.562.0",
    "next": "^16.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
