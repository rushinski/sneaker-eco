    "autoprefixer": "^10.4.22",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.18",
